# ============ 大模型接入配置（复制为 .env 后修改） ============

# ---- 智能对话：Qwen2.5（OpenAI 兼容协议）----
# Ollama（推荐）：先 ollama pull qwen2.5:14b，默认端口 11434
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=ollama
LLM_ENABLED=true

# vLLM 示例：vllm serve Qwen/Qwen2.5-14B-Instruct --port 8000
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# LM Studio 示例：LLM_BASE_URL=http://127.0.0.1:1234/v1

# ---- AI 一键装修图：云端生图 API（填 Key 即启用，优先级最高）----
# 硅基流动（国内直连）：https://cloud.siliconflow.cn 注册 → API 密钥 → 创建
RENDER_PROVIDER=auto
RENDER_API_BASE=https://api.siliconflow.cn/v1
# RENDER_API_KEY=sk-xxxxxxxx
RENDER_API_MODEL=Qwen/Qwen-Image
RENDER_API_STEPS=20
RENDER_API_GUIDANCE=7.5
# Kwai-Kolors/Kolors 更快且支持图生图（guidance 7.5 合适）；Qwen-Image 建议 RENDER_API_GUIDANCE=4.0
# 通义万相（阿里云百炼 DashScope）示例：
# RENDER_API_BASE=https://dashscope.aliyuncs.com/api/v1
# RENDER_API_MODEL=wanx2.1-t2i-turbo

# ---- AI 一键装修图：ComfyUI（无云端 Key 时尝试本机 8188）----
# 启动 ComfyUI（默认端口 8188）后自动进入真实渲染模式；
# 未配置 Key 且未启动时自动降级演示模式（模拟进度 + 风格色板占位图）
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 可选：外置 api 格式 workflow JSON（ControlNet-MLSD + SDXL + LoRA + RealESRGAN）
# COMFYUI_WORKFLOW=workflows/interior_sdxl_mlsd.json
RENDER_SIM_SECONDS=6

# 强制关闭真实调用（纯演示环境）
# LLM_ENABLED=false

# ---- Agent ���̻���P0��Ĭ�ϱ��ؿ�������----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-prod
VECTOR_DB_URL=postgresql://postgres:postgres@localhost:5432/agent

