# 开发环境配置
VITE_APP_TITLE=房地产 AI 销售助手平台 (开发环境)
VITE_API_BASE_URL=/api/v1
# 注意：Vite 环境变量优先级为 .env.development > .env.local，
# 若在此处硬编码 VITE_API_PROXY_TARGET，会覆盖本机 .env.local 的配置，
# 导致代理打到 8000（被其他项目占用）而报 500。故留空，回落到 vite.config.ts 的默认 8000。
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_ENABLE_MOCK=true
VITE_ENABLE_DEVTOOLS=true